{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tictactoe.invalid/contracts/events/ws-client.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "auth"
          ]
        },
        "ticket": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "ticket"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "subscribe"
          ]
        },
        "matchId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "matchId"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ack"
          ]
        },
        "eventId": {
          "type": "string",
          "format": "uuid"
        },
        "aggregateId": {
          "type": "string",
          "format": "uuid"
        },
        "aggregateVersion": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "eventId",
        "aggregateId",
        "aggregateVersion"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "heartbeat"
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "type",
        "requestId"
      ]
    }
  ]
}
