{
  "openapi": "3.0.3",
  "info": {
    "title": "Game coordination internal API",
    "version": "1.0.0",
    "description": "HTTP only inside trusted mesh. Not exposed through ingress. Caller service credentials are checked independently of user sessions."
  },
  "servers": [
    {
      "url": "http://game:8084/internal/v1"
    }
  ],
  "security": [
    {
      "serviceToken": []
    }
  ],
  "paths": {
    "/participation/claim": {
      "post": {
        "operationId": "claimParticipation",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimParticipation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative coordination result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          }
        }
      }
    },
    "/rooms/register": {
      "post": {
        "operationId": "registerRoom",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRoom"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative coordination result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          }
        }
      }
    },
    "/matches/assign-pair": {
      "post": {
        "operationId": "assignPair",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignPair"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative coordination result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          }
        }
      }
    },
    "/connections/observe": {
      "post": {
        "operationId": "observeConnection",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Connection"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative coordination result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          }
        }
      }
    },
    "/connections/renew": {
      "post": {
        "operationId": "renewLeases",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenewLeases"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative coordination result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          }
        }
      }
    },
    "/participation/logout": {
      "post": {
        "operationId": "logoutParticipation",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutParticipation"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative coordination result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          }
        }
      }
    },
    "/operations/{operationId}": {
      "get": {
        "operationId": "getOperation",
        "parameters": [
          {
            "name": "operationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Durable operation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      }
    },
    "schemas": {
      "ClaimParticipation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          },
          "target": {
            "type": "string",
            "enum": [
              "MENU",
              "QUEUED",
              "LOBBY"
            ]
          },
          "resourceId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "operationId",
          "userId",
          "expectedVersion",
          "target"
        ]
      },
      "RegisterRoom": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "roomId": {
            "type": "string",
            "format": "uuid"
          },
          "ownerId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "operationId",
          "roomId",
          "ownerId",
          "expectedVersion"
        ]
      },
      "AssignPair": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "matchId": {
            "type": "string",
            "format": "uuid"
          },
          "players": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "userId": {
                  "type": "string",
                  "format": "uuid"
                },
                "expectedVersion": {
                  "type": "integer",
                  "minimum": 0
                },
                "ticketId": {
                  "type": "string",
                  "format": "uuid"
                },
                "originalSequence": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                }
              },
              "required": [
                "userId",
                "expectedVersion",
                "ticketId",
                "originalSequence"
              ]
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "operationId",
          "matchId",
          "players"
        ]
      },
      "Operation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPLIED",
              "REJECTED"
            ]
          },
          "resourceId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "operationId",
          "status",
          "version"
        ]
      },
      "Connection": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "matchId": {
            "type": "string",
            "format": "uuid"
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "connected": {
            "type": "boolean"
          }
        },
        "required": [
          "operationId",
          "userId",
          "matchId",
          "generation",
          "connected"
        ]
      },
      "RenewLeases": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "userId": {
                  "type": "string",
                  "format": "uuid"
                },
                "matchId": {
                  "type": "string",
                  "format": "uuid"
                },
                "generation": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "userId",
                "matchId",
                "generation"
              ]
            },
            "maxItems": 1000
          }
        },
        "required": [
          "operationId",
          "connections"
        ]
      },
      "LogoutParticipation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "operationId",
          "userId",
          "sessionId"
        ]
      },
      "Introspection": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "token"
        ]
      },
      "IntrospectionResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "active": {
            "type": "boolean"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "active"
        ]
      },
      "ConsumeTicket": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ticket": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ticket"
        ]
      }
    }
  }
}
