# Local non-secret settings. Process environment takes precedence.
# Secrets are supplied by scripts/run-service.py from infra/local/.env and secrets/.
PORT=8082
NATS_URL=nats://127.0.0.1:4222
NATS_USER=app
PG_JDBC_URL=jdbc:postgresql://127.0.0.1:5432/user
PGUSER=user

MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
METRIC_REFRESH_MS=5000
